# Copy to broker.env and fill in. broker.env is gitignored -- never commit creds.
# Used by tools/*.py (PC dev tools). The firmware gets the same values via
# `idf.py menuconfig` (OSOS Gateway Configuration menu).

# --- Broker ---
# Dev default: EMQX public playground (no account, NO AUTH, anyone can read --
# sim data only, and use a unique GW_ID suffix to avoid collisions).
# Production: EMQX Serverless (cloud.emqx.com) -> steps in docs/BROKER.md.
BROKER_HOST=broker.emqx.io
BROKER_TLS_PORT=8883
BROKER_PLAIN_PORT=1883
# What the phone browser page connects to (wss for cloud/TLS, ws for local dev)
BROKER_WSS_URL=wss://broker.emqx.io:8084/mqtt
BROKER_TLS=1

# --- Identity / auth (empty user+pass = anonymous, ok on playground only) ---
GW_ID=dkm440-gw1
MQTT_USER=
MQTT_PASS=

# --- Behaviour ---
REPORT_INTERVAL_DEFAULT=10
CONF_MIN=0.90

# --- Sibling project paths (PC dev tools) ---
# Relative to this repo: ikom_osos/neural_net_c/w.bin (export_weights.py finds it
# automatically; override only if w.bin lives elsewhere)
W_BIN=../neural_net_c/w.bin
